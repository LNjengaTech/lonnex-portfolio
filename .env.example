# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (PostgreSQL - Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/portfolio?sslmode=require

# Authentication (Single Admin)
BETTER_AUTH_SECRET=your-secure-auth-secret-here
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@lonnex.dev
ADMIN_PASSWORD=change-this-in-production

# Cloudinary (Media Pipeline)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL_TO=hello@lonnex.dev

# Privacy-friendly Analytics (Optional)
NEXT_PUBLIC_ANALYTICS_ID=

